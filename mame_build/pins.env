# =============================================================================
# Pinned versions - single source of truth for reproducible MAME builds
# =============================================================================
# MAME 0.223 (mame0223): oldest release with full Game & Watch support.
#   - C++14, GCC 7.2+  -> builds with the default GCC 9.3 in Ubuntu 20.04
#   - GENie rebuilt from source when the prebuilt binary is removed
#     (3rdparty/genie/src is in-tree, no submodules)
MAME_REPO=https://github.com/mamedev/mame
MAME_TAG=mame0223

# G&W-only subset build: only the hh_sm510 driver (+auto-detected deps) is
# compiled. ~50 MB binary instead of ~700 MB, ~12 min build instead of ~1h.
MAME_SOURCES=src/mame/drivers/hh_sm510.cpp

# Ubuntu 20.04: glibc 2.31. The device runs glibc >= 2.31 (a core requiring
# GLIBC_2.30 already runs on it), so binaries built here are compatible.
DOCKER_BASE_IMAGE=ubuntu:20.04

# SDL2 2.0.20: last release with the fbcon video driver (removed in 2.0.22).
# The device has no X11, no libdrm and no SDL2 - fbcon + bundled libSDL2 is
# the deployment strategy.
SDL2_VERSION=2.0.20
SDL2_URL=https://github.com/libsdl-org/SDL/releases/download/release-${SDL2_VERSION}/SDL2-${SDL2_VERSION}.tar.gz

# Build parallelism. Docker Desktop VM has ~8 GB RAM - MAME's emumem.cpp
# alone needs ~2-3 GB, so 4 jobs is the safe limit.
BUILD_JOBS=4

# OPTIMIZE=2 instead of default 3: massively reduces cc1plus memory on the
# giant driver files (cps2.cpp, bfm_sc4.cpp...), which keeps the 8 GB VM
# stable. G&W games are trivially slow to emulate - no performance impact.
OPTIMIZE=2
